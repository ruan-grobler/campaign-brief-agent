# Every environment variable the code reads. The tests and `npm run demo` need none of them.
# Node does not load .env by itself: export what you need, or copy this file to .env and run
# with `node --env-file=.env src/cli.ts examples/brief.md`. Never commit a filled-in .env.

# Live mode on the Claude API. Without it, live mode uses a logged-in Claude Code CLI (`claude`).
ANTHROPIC_API_KEY=

# Port for the control room (`npm run ui`). Defaults to 4410. It always binds to 127.0.0.1.
PORT=

# Set to any value to turn off colour in terminal output.
NO_COLOR=

# Set automatically. Listed for completeness; do not set these yourself.
# CBA_STATE_FILE=   set by the pipeline for each agent's MCP tool server: that agent's state file
# CBA_LOG_FILE=     set the same way: that agent's tool log
# INIT_CWD=         set by npm: the folder you ran npm from, used to resolve the brief path
